# Configure estas variáveis no processo Java ou no provedor de hospedagem.
# Spring Boot não carrega arquivos .env automaticamente.
DB_URL=jdbc:postgresql://localhost:55432/telemicro
DB_USERNAME=telemicro
DB_PASSWORD=replace-with-your-database-password
PORT=8080
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
JWT_ISSUER=telemicro-api
CORS_ALLOWED_ORIGINS=http://localhost:4200
DEMO_ENABLED=false
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_DEMO_EMAIL=
BOOTSTRAP_DEMO_PASSWORD=
LOGIN_RATE_LIMIT=10
SUBMISSION_RATE_LIMIT=20
# No Neon, use a URL JDBC fornecida/configurada com sslmode=require.
# As credenciais de compose.yaml são exclusivamente para desenvolvimento local.
